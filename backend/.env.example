APP_NAME="Administración de Empresas - UAGRM"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=America/La_Paz
APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_ES

LOG_CHANNEL=single
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=cae_portal
DB_USERNAME=postgres
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=public

# Correo (formulario de contacto). "log" lo escribe en storage/logs en vez de enviarlo.
MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-responder@cae.test"
MAIL_FROM_NAME="${APP_NAME}"

# React (Vite) en desarrollo y Laravel comparten la sesión por cookie
SANCTUM_STATEFUL_DOMAINS=localhost:5173,127.0.0.1:5173,localhost:8000,127.0.0.1:8000

# Contraseña de los usuarios de prueba que crea el seeder (cada uno pone la suya; si está vacía no se crean)
SEMILLA_CLAVE=
